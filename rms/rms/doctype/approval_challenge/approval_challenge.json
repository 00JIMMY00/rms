{
  "doctype": "DocType",
  "name": "Approval Challenge",
  "module": "RMS",
  "engine": "InnoDB",
  "autoname": "naming_series:",
  "naming_rule": "By \"Naming Series\" field",
  "search_fields": "subject_doctype,subject_name,requester,approver",
  "sort_field": "creation",
  "sort_order": "DESC",
  "title_field": "",
  "track_changes": 1,
  "field_order": [
    "scope_section",
    "naming_series",
    "store",
    "subject_doctype",
    "subject_name",
    "action",
    "rms_column_scope_section_1",
    "status",
    "requester",
    "approver",
    "expires_at",
    "used_at",
    "rms_operation_section",
    "operation_summary",
    "rms_security_section",
    "code_hash",
    "approval_context_hash",
    "failed_attempts",
    "operation_payload"
  ],
  "fields": [
    {
      "fieldname": "scope_section",
      "fieldtype": "Section Break",
      "label": "Operation approval"
    },
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "RMS-APR-.YYYY.-",
      "default": "RMS-APR-.YYYY.-",
      "hidden": 1
    },
    {
      "fieldname": "store",
      "fieldtype": "Link",
      "label": "Store",
      "options": "Store",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2,
      "link_filters": "[[\"Store\", \"enabled\", \"=\", 1]]"
    },
    {
      "fieldname": "subject_doctype",
      "fieldtype": "Link",
      "label": "Document Type",
      "options": "DocType",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "subject_name",
      "fieldtype": "Dynamic Link",
      "label": "Document",
      "options": "subject_doctype",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "action",
      "fieldtype": "Data",
      "label": "Action",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "rms_column_scope_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Pending\nIssued\nConsumed\nExpired\nRevoked",
      "default": "Issued",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2
    },
    {
      "fieldname": "requester",
      "fieldtype": "Link",
      "label": "Requested By",
      "options": "User",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "approver",
      "fieldtype": "Link",
      "label": "Approver",
      "options": "User",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "expires_at",
      "fieldtype": "Datetime",
      "label": "Expires At",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "used_at",
      "fieldtype": "Datetime",
      "label": "Consumed At",
      "read_only": 1
    },
    {
      "fieldname": "rms_operation_section",
      "fieldtype": "Section Break",
      "label": "Operation details"
    },
    {
      "fieldname": "operation_summary",
      "fieldtype": "HTML",
      "label": "Operation Details",
      "read_only": 1
    },
    {
      "fieldname": "rms_security_section",
      "fieldtype": "Section Break",
      "label": "Internal approval data",
      "hidden": 1
    },
    {
      "fieldname": "code_hash",
      "fieldtype": "Data",
      "label": "One-Time Code Hash",
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "approval_context_hash",
      "fieldtype": "Data",
      "label": "Approved Context Hash",
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "failed_attempts",
      "fieldtype": "Int",
      "label": "Failed Attempts",
      "default": 0,
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "operation_payload",
      "fieldtype": "Long Text",
      "label": "Approved Operation",
      "read_only": 1,
      "hidden": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "report": 1
    },
    {
      "role": "POS Manager",
      "read": 1,
      "report": 1
    }
  ]
}
