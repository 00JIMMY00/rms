{
  "doctype": "DocType",
  "name": "POS User",
  "module": "RMS",
  "engine": "InnoDB",
  "autoname": "field:user",
  "title_field": "full_name",
  "search_fields": "user,full_name,employee",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": [
    "identity_section",
    "user",
    "full_name",
    "rms_column_identity_section_1",
    "employee",
    "enabled",
    "store_section",
    "stores",
    "view_section",
    "can_view_tables",
    "can_view_open_orders",
    "rms_column_view_section_1",
    "can_view_sales_history",
    "can_reprint_receipts",
    "sales_section",
    "can_checkout",
    "can_edit_open_orders",
    "can_cancel_orders",
    "can_payout",
    "rms_column_sales_section_1",
    "can_transfer_tables",
    "can_split_orders",
    "can_merge_orders",
    "rms_approval_section",
    "can_apply_manual_discount",
    "max_manual_discount_percent",
    "can_void_items",
    "can_void_waste",
    "rms_column_rms_approval_section_1",
    "can_request_returns",
    "can_return_waste",
    "discount_approval_section",
    "discount_approval_password",
    "scope_section",
    "allowed_brands",
    "allowed_order_types",
    "kitchen_section",
    "can_access_kitchen",
    "allowed_preparation_areas",
    "rms_column_kitchen_section_1",
    "can_prepare_orders",
    "can_pick_orders",
    "can_acknowledge_cancellations",
    "permissions_section",
    "roles_summary"
  ],
  "fields": [
    {
      "fieldname": "identity_section",
      "fieldtype": "Section Break",
      "label": "User essentials"
    },
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "label": "User Account",
      "options": "User",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2,
      "description": "Select the login account. Display name and effective roles are fetched from this User.",
      "link_filters": "[[\"User\",\"enabled\",\"=\",\"1\"]]"
    },
    {
      "fieldname": "full_name",
      "fieldtype": "Data",
      "label": "Display Name",
      "fetch_from": "user.full_name",
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2,
      "description": "Name is filled from the selected user account."
    },
    {
      "fieldname": "rms_column_identity_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "in_list_view": 1,
      "columns": 2,
      "link_filters": "[[\"Employee\",\"status\",\"=\",\"Active\"]]"
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 1
    },
    {
      "fieldname": "store_section",
      "fieldtype": "Section Break",
      "label": "Stores and cashier profiles"
    },
    {
      "fieldname": "stores",
      "fieldtype": "Table",
      "label": "Assigned Stores",
      "options": "POS User Store",
      "reqd": 1,
      "description": "Assign stores and optionally a cashier-specific POS profile from that store company. Select at most one default store."
    },
    {
      "fieldname": "view_section",
      "fieldtype": "Section Break",
      "label": "What this user can see",
      "collapsible": 1,
      "collapsible_depends_on": "eval:false"
    },
    {
      "fieldname": "can_view_tables",
      "fieldtype": "Check",
      "label": "View Dining Tables",
      "default": "1",
      "in_list_view": 0
    },
    {
      "fieldname": "can_view_open_orders",
      "fieldtype": "Check",
      "label": "View Open Orders",
      "default": "1"
    },
    {
      "fieldname": "rms_column_view_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "can_view_sales_history",
      "fieldtype": "Check",
      "label": "View Closed Sales History",
      "default": "1"
    },
    {
      "fieldname": "can_reprint_receipts",
      "fieldtype": "Check",
      "label": "Reprint Receipts",
      "default": "1"
    },
    {
      "fieldname": "sales_section",
      "fieldtype": "Section Break",
      "label": "Sales and order actions",
      "collapsible": 1,
      "collapsible_depends_on": "eval:false"
    },
    {
      "fieldname": "can_checkout",
      "fieldtype": "Check",
      "label": "Create and Complete Sales",
      "default": "1"
    },
    {
      "fieldname": "can_edit_open_orders",
      "fieldtype": "Check",
      "label": "Add Items to Other Cashiers’ Open Orders",
      "default": "1",
      "description": "Allows adding items and confirming them for preparation. The cashier who opened the order remains responsible for payment, cancellation and session accounting."
    },
    {
      "fieldname": "can_cancel_orders",
      "fieldtype": "Check",
      "label": "Cancel Active Orders",
      "default": "1"
    },
    {
      "fieldname": "can_payout",
      "fieldtype": "Check",
      "label": "Record Expenses Without Approval",
      "default": "0",
      "description": "If disabled, POS expenses require an operation-specific manager approval code."
    },
    {
      "fieldname": "rms_column_sales_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "can_transfer_tables",
      "fieldtype": "Check",
      "label": "Transfer Orders Between Tables",
      "default": "1"
    },
    {
      "fieldname": "can_split_orders",
      "fieldtype": "Check",
      "label": "Split Table Checks",
      "default": "1"
    },
    {
      "fieldname": "can_merge_orders",
      "fieldtype": "Check",
      "label": "Merge Draft Orders",
      "default": "1"
    },
    {
      "fieldname": "rms_approval_section",
      "fieldtype": "Section Break",
      "label": "Discounts, returns and approvals"
    },
    {
      "fieldname": "can_apply_manual_discount",
      "fieldtype": "Check",
      "label": "Apply Manual Discounts",
      "default": "1"
    },
    {
      "fieldname": "max_manual_discount_percent",
      "fieldtype": "Percent",
      "label": "Maximum Manual Discount (%)",
      "default": "0",
      "description": "Maximum discount this POS User can apply without approval. Larger discounts require authorization from a POS Manager.",
      "depends_on": "eval:doc.can_apply_manual_discount"
    },
    {
      "fieldname": "can_void_items",
      "fieldtype": "Check",
      "label": "Void Confirmed Items Without Approval",
      "default": "0",
      "description": "If disabled, this operation requires a different authorized manager’s fixed password or one-time code."
    },
    {
      "fieldname": "can_void_waste",
      "fieldtype": "Check",
      "label": "Void Items as Waste Without Approval",
      "default": "0",
      "description": "If disabled, this operation requires a different authorized manager’s fixed password or one-time code.",
      "depends_on": "eval:doc.can_void_items"
    },
    {
      "fieldname": "rms_column_rms_approval_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "can_request_returns",
      "fieldtype": "Check",
      "label": "Returns Without Approval",
      "default": "1",
      "description": "If disabled, completing a return requires manager password or a one-time code."
    },
    {
      "fieldname": "can_return_waste",
      "fieldtype": "Check",
      "label": "Return Items as Waste Without Approval",
      "default": "0",
      "description": "If disabled, this operation requires a different authorized manager’s fixed password or one-time code.",
      "depends_on": "eval:doc.can_request_returns"
    },
    {
      "fieldname": "discount_approval_section",
      "fieldtype": "Section Break",
      "label": "Manager approval password",
      "collapsible": 1,
      "collapsible_depends_on": "eval:false"
    },
    {
      "fieldname": "discount_approval_password",
      "fieldtype": "Password",
      "label": "Fixed POS Approval Password",
      "description": "Separate encrypted approval password for discounts, voids and returns. This is not your sign-in password."
    },
    {
      "fieldname": "scope_section",
      "fieldtype": "Section Break",
      "label": "Limit brands and order types",
      "collapsible": 1,
      "collapsible_depends_on": "eval:(doc.allowed_brands && doc.allowed_brands.length) || (doc.allowed_order_types && doc.allowed_order_types.length)"
    },
    {
      "fieldname": "allowed_brands",
      "fieldtype": "Table",
      "label": "Allowed Brands",
      "options": "POS User Brand",
      "description": "Leave empty to allow all Brands available in the assigned Stores."
    },
    {
      "fieldname": "allowed_order_types",
      "fieldtype": "Table",
      "label": "Allowed Order Types",
      "options": "POS User Order Type",
      "description": "Leave empty to allow all Order Types available in the assigned Stores."
    },
    {
      "fieldname": "kitchen_section",
      "fieldtype": "Section Break",
      "label": "Kitchen access",
      "collapsible": 0
    },
    {
      "fieldname": "can_access_kitchen",
      "fieldtype": "Check",
      "label": "View Kitchen Display",
      "default": "1",
      "description": "Also requires a POS Cashier, POS Manager, System Manager, or Kitchen Operator role."
    },
    {
      "fieldname": "allowed_preparation_areas",
      "fieldtype": "Table",
      "label": "Allowed Preparation Areas",
      "options": "POS User Preparation Area",
      "description": "Leave empty to allow all Preparation Areas in the assigned Stores."
    },
    {
      "fieldname": "rms_column_kitchen_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "can_prepare_orders",
      "fieldtype": "Check",
      "label": "Start and Prepare Kitchen Orders",
      "default": "1",
      "description": "Restricts kitchen preparation actions. Starting or preparing tickets also requires the Kitchen Operator, POS Manager, or System Manager role."
    },
    {
      "fieldname": "can_pick_orders",
      "fieldtype": "Check",
      "label": "Mark Orders Picked Up",
      "default": "1",
      "description": "Restricts pickup actions. Marking tickets picked up also requires the Kitchen Operator, POS Manager, or System Manager role."
    },
    {
      "fieldname": "can_acknowledge_cancellations",
      "fieldtype": "Check",
      "label": "Acknowledge Kitchen Cancellations",
      "default": "1",
      "description": "Restricts cancellation acknowledgement. Acknowledging tickets also requires the Kitchen Operator, POS Manager, or System Manager role."
    },
    {
      "fieldname": "permissions_section",
      "fieldtype": "Section Break",
      "label": "Effective account roles",
      "collapsible": 1,
      "collapsible_depends_on": "eval:false"
    },
    {
      "fieldname": "roles_summary",
      "fieldtype": "Small Text",
      "label": "Assigned User Roles",
      "read_only": 1,
      "description": "Effective account roles. POS permissions can restrict access; they do not replace the required account roles."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1
    },
    {
      "role": "POS Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1
    }
  ]
}
