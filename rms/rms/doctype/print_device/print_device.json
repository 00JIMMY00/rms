{
  "doctype": "DocType",
  "name": "Print Device",
  "module": "RMS",
  "engine": "InnoDB",
  "allow_rename": 1,
  "autoname": "field:title",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": [
    "device_section",
    "title",
    "print_method",
    "rms_column_device_section_1",
    "enabled",
    "rms_connection_section",
    "host",
    "port",
    "rms_column_rms_connection_section_1",
    "queue_name",
    "ipp_url",
    "notes_section",
    "comments"
  ],
  "fields": [
    {
      "fieldname": "device_section",
      "fieldtype": "Section Break",
      "label": "Printer essentials"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Device Name",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 4
    },
    {
      "fieldname": "print_method",
      "fieldtype": "Select",
      "label": "Print Method",
      "options": "Network Socket\nIPP\nSystem Queue",
      "default": "Network Socket",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 3
    },
    {
      "fieldname": "rms_column_device_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2
    },
    {
      "fieldname": "rms_connection_section",
      "fieldtype": "Section Break",
      "label": "Connection settings",
      "description": "Only the connection fields for your selected printing method are shown."
    },
    {
      "fieldname": "host",
      "fieldtype": "Data",
      "label": "Host / IP Address",
      "depends_on": "eval:doc.print_method == 'Network Socket'",
      "mandatory_depends_on": "eval:doc.print_method == 'Network Socket'"
    },
    {
      "fieldname": "port",
      "fieldtype": "Int",
      "label": "Port",
      "default": "9100",
      "depends_on": "eval:doc.print_method == 'Network Socket'",
      "mandatory_depends_on": "eval:doc.print_method == 'Network Socket'"
    },
    {
      "fieldname": "rms_column_rms_connection_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "queue_name",
      "fieldtype": "Data",
      "label": "Queue Name",
      "depends_on": "eval:doc.print_method == 'System Queue'",
      "mandatory_depends_on": "eval:doc.print_method == 'System Queue'"
    },
    {
      "fieldname": "ipp_url",
      "fieldtype": "Data",
      "label": "IPP URL",
      "depends_on": "eval:doc.print_method == 'IPP'",
      "mandatory_depends_on": "eval:doc.print_method == 'IPP'"
    },
    {
      "fieldname": "notes_section",
      "fieldtype": "Section Break",
      "label": "Notes",
      "collapsible": 1,
      "collapsible_depends_on": "eval:false"
    },
    {
      "fieldname": "comments",
      "fieldtype": "Small Text",
      "label": "Comments"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "report": 1
    }
  ]
}
