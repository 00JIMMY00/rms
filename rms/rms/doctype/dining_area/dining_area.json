{
  "doctype": "DocType",
  "name": "Dining Area",
  "module": "RMS",
  "engine": "InnoDB",
  "allow_rename": 1,
  "autoname": "field:title",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": [
    "area_section",
    "title",
    "store",
    "restaurant_brand",
    "rms_column_area_section_1",
    "enabled",
    "sequence_id"
  ],
  "fields": [
    {
      "fieldname": "area_section",
      "fieldtype": "Section Break",
      "label": "Dining area"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Area Name",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 3
    },
    {
      "fieldname": "store",
      "fieldtype": "Link",
      "label": "Store",
      "options": "Store",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 3,
      "link_filters": "[[\"Store\",\"enabled\",\"=\",\"1\"]]"
    },
    {
      "fieldname": "restaurant_brand",
      "fieldtype": "Link",
      "label": "Brand",
      "options": "Restaurant Brand",
      "in_standard_filter": 1,
      "link_filters": "[[\"Restaurant Brand\",\"enabled\",\"=\",\"1\"]]"
    },
    {
      "fieldname": "rms_column_area_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2
    },
    {
      "fieldname": "sequence_id",
      "fieldtype": "Int",
      "label": "Display Order",
      "default": "0",
      "in_list_view": 1,
      "columns": 2,
      "description": "Lower numbers appear first."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "report": 1
    }
  ]
}
