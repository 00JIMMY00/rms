{
  "doctype": "DocType",
  "name": "Dining Table",
  "module": "RMS",
  "engine": "InnoDB",
  "allow_rename": 1,
  "autoname": "field:title",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": [
    "table_section",
    "title",
    "store",
    "dining_area",
    "rms_column_table_section_1",
    "capacity",
    "enabled",
    "sequence_id"
  ],
  "fields": [
    {
      "fieldname": "table_section",
      "fieldtype": "Section Break",
      "label": "Table essentials"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Table Name / Number",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2
    },
    {
      "fieldname": "store",
      "fieldtype": "Link",
      "label": "Store",
      "options": "Store",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2,
      "link_filters": "[[\"Store\",\"enabled\",\"=\",\"1\"]]"
    },
    {
      "fieldname": "dining_area",
      "fieldtype": "Link",
      "label": "Dining Area",
      "options": "Dining Area",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2,
      "link_filters": "[[\"Dining Area\",\"store\",\"=\",\"eval:doc.store\"],[\"Dining Area\",\"enabled\",\"=\",\"1\"]]",
      "read_only_depends_on": "eval:!doc.store"
    },
    {
      "fieldname": "rms_column_table_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "capacity",
      "fieldtype": "Int",
      "label": "Capacity",
      "default": "1",
      "non_negative": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2
    },
    {
      "fieldname": "sequence_id",
      "fieldtype": "Int",
      "label": "Display Order",
      "default": "0",
      "description": "Lower numbers appear first."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "report": 1
    }
  ]
}
