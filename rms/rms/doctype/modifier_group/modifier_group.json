{
  "doctype": "DocType",
  "name": "Modifier Group",
  "module": "RMS",
  "engine": "InnoDB",
  "allow_rename": 1,
  "autoname": "field:title",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": [
    "group_section",
    "title",
    "enabled",
    "rms_column_group_section_1",
    "sequence_id",
    "rms_selection_section",
    "allow_multiple_selections",
    "min_selections",
    "rms_column_rms_selection_section_1",
    "max_selections",
    "display_section",
    "allow_collapse",
    "rms_column_display_section_1",
    "collapsed_by_default"
  ],
  "fields": [
    {
      "fieldname": "group_section",
      "fieldtype": "Section Break",
      "label": "Group essentials"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Group Name",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 4
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2
    },
    {
      "fieldname": "rms_column_group_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "sequence_id",
      "fieldtype": "Int",
      "label": "Display Order",
      "default": "0",
      "in_list_view": 1,
      "columns": 2,
      "description": "Lower numbers appear first."
    },
    {
      "fieldname": "rms_selection_section",
      "fieldtype": "Section Break",
      "label": "Selection rules"
    },
    {
      "fieldname": "allow_multiple_selections",
      "fieldtype": "Check",
      "label": "Allow Multiple Selections",
      "default": "1",
      "description": "When disabled, a user can choose at most one option from this group."
    },
    {
      "fieldname": "min_selections",
      "fieldtype": "Int",
      "label": "Minimum Selections",
      "default": "0",
      "description": "Minimum distinct choices. 0 makes the group optional by default; each product can override whether it is required."
    },
    {
      "fieldname": "rms_column_rms_selection_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "max_selections",
      "fieldtype": "Int",
      "label": "Maximum Selections",
      "default": "0",
      "non_negative": 1,
      "description": "For multiple-choice groups, 0 means no maximum. Single-choice groups always allow one choice."
    },
    {
      "fieldname": "display_section",
      "fieldtype": "Section Break",
      "label": "Display in POS"
    },
    {
      "fieldname": "allow_collapse",
      "fieldtype": "Check",
      "label": "Allow Collapse",
      "default": "0"
    },
    {
      "fieldname": "rms_column_display_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "collapsed_by_default",
      "fieldtype": "Check",
      "label": "Collapsed By Default",
      "default": "0",
      "depends_on": "eval:doc.allow_collapse",
      "description": "Optional groups can start collapsed. Required groups start open so the cashier can see the required choices."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "report": 1
    }
  ]
}
