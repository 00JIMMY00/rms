{
  "doctype": "DocType",
  "name": "Waste Entry",
  "module": "RMS",
  "engine": "InnoDB",
  "allow_rename": 1,
  "autoname": "naming_series:",
  "naming_rule": "By \"Naming Series\" field",
  "search_fields": "title",
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "",
  "track_changes": 1,
  "field_order": [
    "waste_section",
    "naming_series",
    "store",
    "store_company",
    "selling_product",
    "rms_column_waste_section_1",
    "quantity",
    "warehouse",
    "order_type",
    "reason",
    "status",
    "rms_items_section",
    "items",
    "rms_documents_section",
    "stock_entry"
  ],
  "fields": [
    {
      "fieldname": "waste_section",
      "fieldtype": "Section Break",
      "label": "Waste record"
    },
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "RMS-WST-.YYYY.-",
      "default": "RMS-WST-.YYYY.-",
      "hidden": 1
    },
    {
      "fieldname": "store",
      "fieldtype": "Link",
      "label": "Store",
      "options": "Store",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2,
      "link_filters": "[[\"Store\",\"enabled\",\"=\",\"1\"]]"
    },
    {
      "fieldname": "store_company",
      "fieldtype": "Link",
      "label": "Store Company",
      "options": "Company",
      "fetch_from": "store.company",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "selling_product",
      "fieldtype": "Link",
      "label": "Selling Product",
      "options": "Selling Product",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2,
      "link_filters": "[[\"Selling Product\",\"enabled\",\"=\",\"1\"]]"
    },
    {
      "fieldname": "rms_column_waste_section_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "quantity",
      "fieldtype": "Float",
      "label": "Quantity",
      "reqd": 1,
      "non_negative": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "warehouse",
      "fieldtype": "Link",
      "label": "Source Warehouse",
      "options": "Warehouse",
      "reqd": 1,
      "link_filters": "[[\"Warehouse\",\"company\",\"=\",\"eval:doc.store_company\"],[\"Warehouse\",\"is_group\",\"=\",\"0\"],[\"Warehouse\",\"disabled\",\"=\",\"0\"]]"
    },
    {
      "fieldname": "order_type",
      "fieldtype": "Link",
      "label": "Order Type",
      "options": "Order Type",
      "link_filters": "[[\"Order Type\",\"enabled\",\"=\",\"1\"]]"
    },
    {
      "fieldname": "reason",
      "fieldtype": "Data",
      "label": "Reason",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2,
      "read_only": 1
    },
    {
      "fieldname": "rms_items_section",
      "fieldtype": "Section Break",
      "label": "Stock to be written off"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Waste Items",
      "options": "Waste Entry Item",
      "reqd": 1,
      "description": "Add rows here. Open a row to see all its settings."
    },
    {
      "fieldname": "rms_documents_section",
      "fieldtype": "Section Break",
      "label": "Stock document",
      "collapsible": 1,
      "collapsible_depends_on": "eval:false"
    },
    {
      "fieldname": "stock_entry",
      "fieldtype": "Link",
      "label": "Stock Entry",
      "options": "Stock Entry",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "report": 1
    }
  ],
  "is_submittable": 1
}
